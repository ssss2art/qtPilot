@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ---------------------------------------------------------------------------
# qtPilot Package Configuration
# Auto-detects the consumer's Qt version (Qt5 or Qt6) and resolves to
# the correct probe binary under lib/.
# ---------------------------------------------------------------------------

# Detect which Qt version the consumer is using.
if(TARGET Qt6::Core)
    set(_qtpilot_qt_major 6)
    get_target_property(_qt_version Qt6::Core VERSION)
    if(NOT _qt_version)
        set(_qt_version "${Qt6Core_VERSION}")
    endif()
elseif(TARGET Qt5::Core)
    set(_qtpilot_qt_major 5)
    get_target_property(_qt_version Qt5::Core VERSION)
    if(NOT _qt_version)
        set(_qt_version "${Qt5Core_VERSION}")
    endif()
else()
    set(qtPilot_FOUND FALSE)
    set(qtPilot_NOT_FOUND_MESSAGE
        "qtPilot requires Qt5 (5.15+) or Qt6. No Qt found. "
        "Call find_package(Qt6) or find_package(Qt5) before find_package(qtPilot).")
    return()
endif()

# Extract major.minor for versioned naming (e.g. "qt6.9")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" _qtpilot_qt_version_match "${_qt_version}")
set(_qtpilot_qt_version_tag "qt${_qtpilot_qt_version_match}")

# What the probe was actually built with. A SHARED probe resolves its own Qt
# dependencies at load time, so an incomplete list here went unnoticed. A STATIC
# probe cannot: the consumer's link has to satisfy every symbol the archive
# references, so Qml/Quick (when QML introspection was compiled in) and Test are
# required rather than optional.
set(QTPILOT_PROBE_STATIC @QTPILOT_PROBE_STATIC@)
set(QTPILOT_HAS_QML @QTPILOT_HAS_QML@)

set(_qtpilot_qt_components Core Network WebSockets Widgets Test)
if(QTPILOT_HAS_QML)
    list(APPEND _qtpilot_qt_components Qml Quick)
endif()

# Find Qt dependencies
if(_qtpilot_qt_major EQUAL 6)
    find_dependency(Qt6 COMPONENTS ${_qtpilot_qt_components})
else()
    find_dependency(Qt5 5.15 COMPONENTS ${_qtpilot_qt_components})
endif()

# Compute paths relative to this config file location.
# Config is installed at: <prefix>/share/cmake/qtPilot/qtPilotConfig.cmake
# Libraries are at:       <prefix>/lib/
set_and_check(QTPILOT_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(QTPILOT_PREFIX "${QTPILOT_CMAKE_DIR}/../../.." ABSOLUTE)

set(QTPILOT_LIB_DIR "${QTPILOT_PREFIX}/lib")
set(QTPILOT_INCLUDE_DIR "${QTPILOT_PREFIX}/include/qtpilot")

# ---------------------------------------------------------------------------
# Create imported target: qtPilot::Probe
# ---------------------------------------------------------------------------
# The probe can be built as a shared library (injected into an already-built app)
# or a static archive (linked into a development build -- the only route on
# Android and iOS). The two need different imported-target shapes, so the build
# records which one was produced rather than letting this file assume.
if(NOT TARGET qtPilot::Probe)
    if(QTPILOT_PROBE_STATIC)
        add_library(qtPilot::Probe STATIC IMPORTED)
    else()
        add_library(qtPilot::Probe SHARED IMPORTED)
    endif()

    set_target_properties(qtPilot::Probe PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${QTPILOT_INCLUDE_DIR}"
    )

    # Library base name matches the build output: qtPilot-probe-qt{M}.{m}
    set(_probe_base_name "qtPilot-probe-${_qtpilot_qt_version_tag}")

    if(QTPILOT_PROBE_STATIC)
        find_file(_probe_archive
            NAMES "lib${_probe_base_name}.a" "${_probe_base_name}.lib"
            PATHS "${QTPILOT_LIB_DIR}"
            NO_DEFAULT_PATH
        )
        if(_probe_archive)
            set_target_properties(qtPilot::Probe PROPERTIES
                IMPORTED_LOCATION "${_probe_archive}"
            )
            # Consumers of a static probe must see this, or QTPILOT_EXPORT expands
            # to __declspec(dllimport) against an archive.
            set_target_properties(qtPilot::Probe PROPERTIES
                INTERFACE_COMPILE_DEFINITIONS "QTPILOT_PROBE_STATIC_BUILD"
            )
            # Force the whole archive in. The probe starts from a file-scope
            # Q_COREAPP_STARTUP_FUNCTION registration that nothing in the consuming
            # app references by name, so a plain link drops that archive member and
            # the probe silently never starts.
            if(APPLE)
                set_target_properties(qtPilot::Probe PROPERTIES
                    INTERFACE_LINK_OPTIONS "LINKER:-force_load,${_probe_archive}"
                )
            elseif(MSVC)
                set_target_properties(qtPilot::Probe PROPERTIES
                    INTERFACE_LINK_OPTIONS "/WHOLEARCHIVE:${_probe_archive}"
                )
            else()
                set_target_properties(qtPilot::Probe PROPERTIES
                    INTERFACE_LINK_OPTIONS
                        "LINKER:--whole-archive;${_probe_archive};LINKER:--no-whole-archive"
                )
            endif()
        else()
            message(WARNING
                "qtPilot: static probe archive lib${_probe_base_name}.a not found in "
                "${QTPILOT_LIB_DIR}; qtPilot::Probe has no location.")
        endif()
    elseif(WIN32)
        find_file(_probe_dll
            NAMES "${_probe_base_name}.dll"
            PATHS "${QTPILOT_LIB_DIR}"
            NO_DEFAULT_PATH
        )
        find_file(_probe_implib
            NAMES "${_probe_base_name}.lib" "${_probe_base_name}.dll.a"
            PATHS "${QTPILOT_LIB_DIR}"
            NO_DEFAULT_PATH
        )
        if(_probe_dll)
            set_target_properties(qtPilot::Probe PROPERTIES
                IMPORTED_LOCATION "${_probe_dll}"
            )
            if(_probe_implib)
                set_target_properties(qtPilot::Probe PROPERTIES
                    IMPORTED_IMPLIB "${_probe_implib}"
                )
            endif()
        endif()
    else()
        # .dylib as well as .so -- macOS builds a framework-style dylib and was
        # previously left without an IMPORTED_LOCATION entirely.
        find_file(_probe_so
            NAMES "lib${_probe_base_name}.dylib" "lib${_probe_base_name}.so"
            PATHS "${QTPILOT_LIB_DIR}"
            NO_DEFAULT_PATH
        )
        if(_probe_so)
            set_target_properties(qtPilot::Probe PROPERTIES
                IMPORTED_LOCATION "${_probe_so}"
            )
        endif()
    endif()

    # Link Qt dependencies on the imported target, from the same component list
    # resolved above so the two cannot drift apart.
    set(_qtpilot_qt_link "")
    foreach(_component IN LISTS _qtpilot_qt_components)
        list(APPEND _qtpilot_qt_link "Qt${_qtpilot_qt_major}::${_component}")
    endforeach()
    # Non-Qt libraries the archive itself references (CoreGraphics on Apple, X11/
    # XTest on Linux). Recorded by the build rather than guessed, and needed only
    # for a static probe.
    if(QTPILOT_PROBE_STATIC)
        list(APPEND _qtpilot_qt_link @QTPILOT_PROBE_STATIC_EXTRA_LIBS@)
    endif()
    set_target_properties(qtPilot::Probe PROPERTIES
        INTERFACE_LINK_LIBRARIES "${_qtpilot_qt_link}"
    )
    unset(_component)
    unset(_qtpilot_qt_link)
endif()

# Include helper functions
include("${CMAKE_CURRENT_LIST_DIR}/qtPilot_inject_probe.cmake")

# Clean up temporary variables
unset(_qtpilot_qt_major)
unset(_qt_version)
unset(_qtpilot_qt_version_match)
unset(_qtpilot_qt_version_tag)
unset(_probe_base_name)
unset(_probe_dll CACHE)
unset(_probe_implib CACHE)
unset(_probe_so CACHE)
unset(_probe_archive CACHE)
unset(_qtpilot_qt_components)

check_required_components(qtPilot)
